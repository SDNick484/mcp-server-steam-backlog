# Settings for mcp-server-steam-backlog (deploy/alpine): root:mcp-steam-backlog, mode 0640.
# Sourced by run.sh as shell: KEY=value, quote values with spaces. The service and the command
# on PATH both read it; a variable set in the caller's environment wins over this file.
# After changing it: rc-service mcp-server-steam-backlog restart

# steam-backlog-triage's backlog_server.py. It has no authentication: keep it on this machine.
BACKLOG_URL=http://127.0.0.1:8484
#BACKLOG_DRY_RUN=1          # read everything, change nothing
#BACKLOG_WRITE_RATE=60      # writes per minute across all sessions
#BACKLOG_DEBUG=1

# --- HTTP and Cloudflare Access (the service) ------------------------------------------
# 127.0.0.1 when cloudflared runs on this machine with host networking; this machine's LAN
# address if cloudflared reaches it over a network (then Access is required). Without
# CF_ACCESS_* it serves only requests that start on this machine (src/.../remote.py).
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8486
MCP_HTTP_PATH=/mcp/backlog
# The public hostname Cloudflare forwards (Host header checks).
#MCP_PUBLIC_HOSTS=backlog.example.com

# Cloudflare Access: the team domain and the MCP Access application's AUD tag. Every request
# must then carry a valid Access assertion, checked here as well as at Cloudflare's edge.
#CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
#CF_ACCESS_AUD=<the Access application's AUD tag>
# Optional: only these identities, on top of whatever the Access policy admits.
#MCP_ALLOWED_EMAILS=you@example.com

# --- Now playing on the Steam Deck (optional) ------------------------------------------
# Off unless MQTT_HOST is set. A read-only login (ACL: topic read deck-ha-bridge/#) for the
# Deck bridge's retained state. Set the password here with vim on the server, never in chat;
# it's redacted from logs. Check it with: mcp-server-steam-backlog doctor --probe-acl
#MQTT_HOST=broker.example.com
#MQTT_PORT=1883
#MQTT_USER=mcp-steam-backlog
#MQTT_PASSWORD=
#MQTT_TLS=1                 # TLS with the system CAs (port 8883 unless MQTT_PORT says otherwise)
#DECK_STATE_TOPIC=deck-ha-bridge/+/state
